# Secrets de las Edge Functions: npx supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL y las claves del proyecto las inyecta Supabase (el prefijo SUPABASE_ está reservado).
RESEND_API_KEY=

# Partes de trabajo en papel (funciones whatsapp y leer-parte)
# Clave de la API de Anthropic (console.anthropic.com): lee la letra de los partes
ANTHROPIC_API_KEY=
# App de Meta con WhatsApp Business (developers.facebook.com → la app → WhatsApp → Configuración de la API)
# Token de acceso permanente (de un usuario del sistema de la cuenta de Meta Business)
WHATSAPP_TOKEN=
# Identificador del número de teléfono (no el número)
WHATSAPP_NUMERO_ID=
# Secreto de la app (Configuración de la app → Básica): firma los avisos que manda Meta
WHATSAPP_SECRETO_APP=
# Texto que nos inventamos y se escribe igual en Meta al dar de alta el webhook
WHATSAPP_TOKEN_VERIFICACION=
