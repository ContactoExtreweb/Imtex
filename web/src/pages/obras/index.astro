---
import Cierre from '../../components/Cierre.astro'
import MapaObras from '../../components/MapaObras.astro'
import Objeto3D from '../../components/Objeto3D.astro'
import Portadilla from '../../components/Portadilla.astro'
import TarjetaObra from '../../components/TarjetaObra.astro'
import Base from '../../layouts/Base.astro'
import { SERVICIOS } from '../../lib/empresa'
import { CACHE_GALERIA, obrasPublicadas, type Obra } from '../../lib/galeria'
import { SEDE, situar } from '../../lib/lugares'

// Bajo demanda: lo que IMTEX publica en el CRM sale aquí sin volver a desplegar
export const prerender = false

let obras: Obra[] = []
let fallo = false
try {
  obras = (await obrasPublicadas()).filter((o) => o.fotos.length > 0)
} catch (error) {
  console.error(error)
  fallo = true
}
Astro.response.headers.set('Netlify-CDN-Cache-Control', CACHE_GALERIA)

// Filtro por servicio, con enlaces normales: /obras?servicio=impermeabilizacion
const filtro = SERVICIOS.find((s) => s.slug === Astro.url.searchParams.get('servicio'))
const visibles = filtro ? obras.filter((o) => o.servicio === filtro.categoria) : obras
const filtros = [
  { a: '/obras', texto: 'Todas', n: obras.length, activo: !filtro },
  ...SERVICIOS.map((s) => ({
    a: `/obras?servicio=${s.slug}`,
    texto: s.nombre,
    n: obras.filter((o) => o.servicio === s.categoria).length,
    activo: filtro?.slug === s.slug,
  })).filter((f) => f.n > 0),
]

// El mapa de la entrada: cada obra en su sitio. La que no se sitúe (lib/lugares.ts) no sale en el mapa.
const enMapa = obras.flatMap((o) => {
  const p = situar(o.ubicacion)
  if (!p) console.warn(`Mapa de obras: no se reconoce el lugar «${o.ubicacion}» de ${o.slug}`)
  return p ? [{ slug: o.slug, titulo: o.titulo, lugar: o.ubicacion ?? '', anio: o.anio ?? '', x: p[0], y: p[1] }] : []
})
---

<Base
  titulo={filtro ? `Obras de ${filtro.nombre.toLowerCase()}` : 'Obras de referencia'}
  descripcion="Obras de referencia de IMTEX desde 2010: Central Nuclear de Almaraz, aeropuertos de Sevilla y Bilbao, transvase Tajo-Segura, E.T.A.P. de Torrelaguna, Bodegas Williams & Humbert y más."
>
  <Portadilla titulo="Obras de referencia">
    {obras.length} obras documentadas, de 2010 a hoy: qué había, qué se hizo y con qué sistema, paso a paso.
    {
      enMapa.length > 0 && (
        <Objeto3D
          slot="objeto"
          escena="obras"
          etiqueta={`Mapa de España y Portugal en relieve con ${enMapa.length} obras de IMTEX, que se encienden una a una.`}
          datos={{ sede: SEDE, obras: enMapa }}
        >
          <MapaObras slot="sustituto" puntos={enMapa.map((o) => [o.x, o.y])} sede={SEDE} />
          <a data-obra href="/obras" class="group grid grid-cols-[4.5rem_1fr] items-baseline gap-x-4 gap-y-1 border-t border-(--filete) pt-3 no-underline">
            <span data-cuenta class="rotulo text-rojo-tinta tabular-nums">{enMapa.length} obras</span>
            <span data-titulo class="titular text-2xl transition-colors duration-200 group-hover:text-rojo-tinta">De Bilbao a La Palma, y en Lisboa</span>
            <span data-lugar class="rotulo col-start-2 text-pizarra">Desde 2010</span>
          </a>
        </Objeto3D>
      )
    }
  </Portadilla>

  <section class="contenedor pb-16 lg:pb-28">
    <nav aria-label="Filtrar por servicio" data-aparece>
      <ul class="flex flex-wrap gap-2">
        {
          filtros.map((f) => (
            <li>
              <a
                href={f.a}
                aria-current={f.activo ? 'true' : undefined}
                class="rotulo flex min-h-11 items-center gap-2 border border-(--filete) px-4 no-underline transition-colors duration-200 hover:border-tinta aria-[current]:border-rojo aria-[current]:bg-rojo aria-[current]:text-negro"
              >
                {f.texto}
                <span class="tabular-nums opacity-70">{f.n}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {fallo && <p role="alert" class="mt-10 text-lg">No se han podido cargar las obras. Vuelve a intentarlo en unos minutos.</p>}
    {
      !fallo && visibles.length === 0 && (
        <p class="mt-10 text-lg text-pizarra">
          Todavía no hay obras publicadas en este apartado. <a href="/obras" class="enlace">Ver todas</a>
        </p>
      )
    }
    <ul class="mt-10 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
      {
        visibles.map((o, i) => (
          <li>
            <TarjetaObra obra={o} orden={i} />
          </li>
        ))
      }
    </ul>
  </section>

  <Cierre />
</Base>
