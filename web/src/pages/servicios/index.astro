---
import { Image } from 'astro:assets'
import Cierre from '../../components/Cierre.astro'
import Objeto3D from '../../components/Objeto3D.astro'
import Portadilla from '../../components/Portadilla.astro'
import Base from '../../layouts/Base.astro'
import { SERVICIOS } from '../../lib/empresa'
import { caratulaServicio } from '../../lib/fotos-servicios'
---

<Base
  titulo="Servicios"
  descripcion="Impermeabilización, reparación y refuerzo de estructuras de hormigón, resinas epoxi y poliuretano, y otros trabajos especializados para industria y construcción."
>
  <Portadilla titulo="Servicios">
    Cuatro especialidades y un mismo oficio: preparar bien el soporte y aplicar el sistema que le corresponde, homologados por quien lo fabrica.
    <Objeto3D
      slot="objeto"
      escena="servicios"
      etiqueta="Maqueta de un tablero de hormigón sobre una viga en la que se ven, uno tras otro, los cuatro servicios: se coloca una lámina, se repara y refuerza la viga, se extiende una resina y se sella la junta."
      foto={caratulaServicio('impermeabilizacion')}
      alt="Impermeabilización de una cubierta"
    >
      {/* Regla de servicios: el de cada momento, en rojo. Al señalar uno, la maqueta va a él. */}
      <ol class="grid grid-cols-2 border-t border-(--filete)" aria-label="Servicios">
        {
          SERVICIOS.map((s, i) => (
            <li class="border-b border-l border-(--filete)">
              <a
                href={`/servicios/${s.slug}`}
                data-paso={i}
                class="rotulo relative block py-3 pl-2 text-pizarra/80 no-underline transition-colors duration-500 ease-(--ease-encaje) before:absolute before:-top-px before:left-0 before:h-0.5 before:w-full before:origin-left before:scale-x-0 before:bg-rojo before:transition-transform before:duration-500 before:ease-(--ease-encaje) hover:text-tinta aria-[current]:text-tinta aria-[current]:before:scale-x-100"
              >
                <span class="block tabular-nums">{`0${i + 1}`}</span>
                {s.nombre}
              </a>
            </li>
          ))
        }
      </ol>
    </Objeto3D>
  </Portadilla>

  <ul class="contenedor pb-16 lg:pb-28">
    {
      SERVICIOS.map((s, i) => (
        <li class="border-t border-(--filete) first:border-t-0">
          <a
            href={`/servicios/${s.slug}`}
            class="group grid items-center gap-x-14 gap-y-6 py-10 no-underline lg:grid-cols-2 lg:py-16"
          >
            {/* La foto alterna de lado y se mueve algo más despacio que la página */}
            <div class:list={['registro aspect-[5/3] overflow-hidden bg-gris', i % 2 === 1 && 'lg:order-last']}>
              <Image
                src={caratulaServicio(s.slug)}
                alt=""
                widths={[480, 900]}
                sizes="(min-width: 64rem) 40rem, 92vw"
                loading={i === 0 ? 'eager' : 'lazy'}
                class="paralaje size-full scale-[1.16] object-cover"
              />
            </div>
            <div data-aparece>
              <h2 class="titular text-[clamp(2.2rem,4.6vw,4rem)] transition-colors duration-300 group-hover:text-rojo-tinta">{s.nombre}</h2>
              <p class="mt-4 max-w-[52ch] text-lg text-pizarra">{s.resumen}</p>
              <ul class="mt-6 grid gap-2 border-t border-(--filete) pt-5">
                {s.sistemas.slice(0, 3).map((x) => (
                  <li class="text-pizarra">{x}</li>
                ))}
              </ul>
              <span class="rotulo mt-6 flex items-center gap-2 text-rojo-tinta">
                Ver {s.sistemas.length > 3 ? `los ${s.sistemas.length} sistemas` : 'el servicio'} y sus obras
                <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4 fill-none stroke-current stroke-2 transition-transform duration-300 ease-(--ease-encaje) group-hover:translate-x-1.5">
                  <path d="M4 12h15M13 6l6 6-6 6" />
                </svg>
              </span>
            </div>
          </a>
        </li>
      ))
    }
  </ul>

  <Cierre />
</Base>
