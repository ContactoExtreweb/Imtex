---
import { Image } from 'astro:assets'
import iso14001 from '../assets/empresa/14001.jpg'
import iso9001 from '../assets/empresa/9001.jpg'
import calidad from '../assets/empresa/calidad.png'
import clasificada from '../assets/empresa/empresa_clasificada.png'
import nosotros from '../assets/empresa/sobrenosotrosw.jpg'
import Cierre from '../components/Cierre.astro'
import Portadilla from '../components/Portadilla.astro'
import Base from '../layouts/Base.astro'
import { CLASIFICACION, EMPRESA, FABRICANTES, NEGOCIO } from '../lib/empresa'
---

<Base
  titulo="Empresa"
  descripcion="IMTEX, Impermeabilizaciones y Montajes Extremeños: empresa aplicadora de Villanueva de la Serena (Badajoz) con más de 25 años de experiencia, homologada por SIKA, Drizoro, Renolit, Soprema y Danosa, y certificada ISO 9001 e ISO 14001."
  datos={[NEGOCIO]}
>
  <Portadilla titulo="Más de 25 años aplicando">
    {EMPRESA.nombreLargo}, S.L. es una empresa extremeña, con sede en {EMPRESA.localidad} ({EMPRESA.provincia}), dedicada a la impermeabilización y a la
    aplicación de productos químicos para la industria y la construcción.
  </Portadilla>

  <section class="contenedor grid gap-x-16 gap-y-10 pb-14 lg:grid-cols-2 lg:pb-24">
    <div class="registro aspect-[4/3] overflow-hidden bg-gris">
      <Image src={nosotros} alt="Trabajos de IMTEX en obra" widths={[480, 900]} sizes="(min-width: 64rem) 40rem, 92vw" loading="eager" class="paralaje size-full scale-[1.16] object-cover" />
    </div>
    <div data-aparece class="prosa text-lg">
      <p>Llevamos más de 25 años haciendo tres cosas:</p>
      <ul>
        <li>Impermeabilizar, con todo tipo de sistemas.</li>
        <li>Reparar estructuras de hormigón con morteros según UNE-EN 1504 y reforzarlas con fibra de carbono.</li>
        <li>Aplicar resinas epoxi y poliuretano en acabados de protección y pavimentos continuos.</li>
      </ul>
      <p>
        Trabajamos con fabricantes de primer nivel, que nos homologan como aplicadores de confianza. Y pertenecemos al Club DIR, una asociación de empresas
        aplicadoras expertas que busca el nivel técnico necesario para poner bien en obra los productos químicos para la construcción.
      </p>
      <p>
        Para mejorar nuestros procesos y respetar el medio ambiente, tenemos certificadas la calidad y la gestión ambiental por OCA Global, y la clasificación
        de empresa para la ejecución de obras.
      </p>
      <p>
        <a href="/obras">Ver las obras de referencia</a>
      </p>
    </div>
  </section>

  {/* Los fabricantes, a gran tamaño: una banda que se desliza despacio al cruzar la pantalla */}
  <section class="overflow-hidden border-y border-(--filete) py-10 lg:py-14" aria-label="Fabricantes que nos homologan">
    <p class="contenedor rotulo text-pizarra">Aplicador homologado por</p>
    <p class="titular deriva mt-4 text-[clamp(2.6rem,9vw,8rem)] leading-none whitespace-nowrap">
      {FABRICANTES.map((f, i) => (
        <>
          {i > 0 && <span class="mx-[0.25em] text-rojo" aria-hidden="true">/</span>}
          {f}
        </>
      ))}
    </p>
  </section>

  <section class="contenedor grid gap-x-16 gap-y-10 py-14 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:py-24">
    <h2 data-aparece class="titular text-[clamp(1.9rem,3.6vw,3.25rem)]">Certificaciones y clasificación</h2>
    <dl class="border-t border-tinta">
      <div data-aparece style="--i: 0" class="grid gap-4 border-b border-(--filete) py-6 sm:grid-cols-[12rem_1fr]">
        <dt class="rotulo pt-1 text-pizarra">Calidad y medio ambiente</dt>
        <dd class="grid gap-5">
          <p>ISO 9001 de gestión de la calidad e ISO 14001 de gestión ambiental, certificadas por OCA Global.</p>
          <div class="flex flex-wrap items-center gap-5">
            <Image src={iso9001} alt="Certificado ISO 9001 de OCA Global" width={360} class="h-auto w-44 border border-(--filete) sm:w-56" />
            <Image src={iso14001} alt="Certificado ISO 14001 de OCA Global" width={360} class="h-auto w-44 border border-(--filete) sm:w-56" />
            <Image src={calidad} alt="Sello de calidad" width={314} class="h-auto w-36 bg-white p-2" />
          </div>
        </dd>
      </div>
      <div data-aparece style="--i: 1" class="grid gap-4 border-b border-(--filete) py-6 sm:grid-cols-[12rem_1fr]">
        <dt class="rotulo pt-1 text-pizarra">Clasificación de empresa</dt>
        <dd class="grid gap-5">
          <p class="titular text-[clamp(1.75rem,3.2vw,2.9rem)] tabular-nums">{CLASIFICACION.join(' · ')}</p>
          <p class="text-pizarra">Clasificación para la ejecución de obras para las administraciones públicas.</p>
          <Image src={clasificada} alt="Sello de empresa clasificada" width={314} class="h-auto w-36 bg-white p-2" />
        </dd>
      </div>
      <div data-aparece style="--i: 2" class="grid gap-4 border-b border-(--filete) py-6 sm:grid-cols-[12rem_1fr]">
        <dt class="rotulo pt-1 text-pizarra">Asociación</dt>
        <dd>Club DIR, asociación de empresas aplicadoras de productos químicos para la construcción.</dd>
      </div>
      <div data-aparece style="--i: 3" class="grid gap-4 border-b border-(--filete) py-6 sm:grid-cols-[12rem_1fr]">
        <dt class="rotulo pt-1 text-pizarra">Sede</dt>
        <dd>
          {EMPRESA.direccion}, {EMPRESA.cp}
          {EMPRESA.localidad} ({EMPRESA.provincia}).
          <a href="/contacto" class="enlace ml-1">Cómo llegar</a>
        </dd>
      </div>
    </dl>
  </section>

  <Cierre />
</Base>
