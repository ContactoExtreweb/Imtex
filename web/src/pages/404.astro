---
import Base from '../layouts/Base.astro'
import { SERVICIOS } from '../lib/empresa'

const enlaces = [
  { a: '/obras', texto: 'Obras de referencia' },
  ...SERVICIOS.map((s) => ({ a: `/servicios/${s.slug}`, texto: s.nombre })),
  { a: '/contacto', texto: 'Contacto' },
]
---

<Base titulo="Página no encontrada" descripcion="Esta página no existe o ha cambiado de dirección." sinIndexar>
  <section class="contenedor grid min-h-[70svh] content-center gap-x-16 gap-y-10 py-16 lg:grid-cols-2">
    <div>
      <h1 class="titular text-[clamp(2.6rem,7vw,6rem)]">Aquí no hay nada que impermeabilizar</h1>
      <p class="mt-6 max-w-[48ch] text-lg text-pizarra">La página que buscas no existe o ha cambiado de dirección. Prueba con una de estas.</p>
      <a href="/" class="boton mt-8">Ir al inicio</a>
    </div>
    <ul class="self-center border-t border-tinta">
      {
        enlaces.map((e) => (
          <li class="border-b border-(--filete)">
            <a href={e.a} class="titular block py-4 text-3xl no-underline hover:text-rojo-tinta">
              {e.texto}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
