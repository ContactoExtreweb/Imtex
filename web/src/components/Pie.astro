---
import { EMPRESA, NAVEGACION } from '../lib/empresa'
import Logo from './Logo.astro'

const legales = [
  { a: '/aviso-legal', texto: 'Aviso legal' },
  { a: '/privacidad', texto: 'Privacidad' },
  { a: '/cookies', texto: 'Cookies' },
]
---

<footer class="sobre-noche bg-noche text-claro">
  <div class="contenedor grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr] md:py-16">
    <div>
      <Logo fijo ancho={360} class="h-20 w-auto lg:h-24" />
      <p class="mt-5 max-w-[32ch] text-claro/75">
        {EMPRESA.nombreLargo}. Aplicadores especializados desde hace más de 25 años.
      </p>
    </div>

    <nav aria-label="Pie">
      <ul class="grid gap-1">
        {
          NAVEGACION.map((n) => (
            <li>
              <a href={n.a} class="rotulo inline-block py-3 text-[0.9375rem] no-underline hover:text-rojo">
                {n.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <address class="grid content-start gap-1 not-italic text-claro/85">
      <span>{EMPRESA.direccion}</span>
      <span>
        {EMPRESA.cp}
        {EMPRESA.localidad} ({EMPRESA.provincia})
      </span>
      <a href={EMPRESA.telefonoEnlace} class="mt-3 w-fit py-2 font-semibold text-claro no-underline hover:text-rojo">{EMPRESA.telefono}</a>
      <a href={`mailto:${EMPRESA.email}`} class="w-fit py-2 font-semibold text-claro no-underline hover:text-rojo">{EMPRESA.email}</a>
      <span class="mt-3 flex gap-5">
        <a href={EMPRESA.linkedin} class="rotulo py-3.5 no-underline hover:text-rojo" rel="noopener">LinkedIn</a>
        <a href={EMPRESA.youtube} class="rotulo py-3.5 no-underline hover:text-rojo" rel="noopener">YouTube</a>
      </span>
    </address>
  </div>

  <div class="border-t border-claro/15">
    <div class="contenedor flex flex-wrap items-center gap-x-6 gap-y-2 py-5 text-sm text-claro/70">
      <span>© {new Date().getFullYear()} {EMPRESA.razonSocial}</span>
      <ul class="flex flex-wrap gap-x-5">
        {
          legales.map((l) => (
            <li>
              <a href={l.a} class="inline-block py-2.5 no-underline hover:text-claro hover:underline">
                {l.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
